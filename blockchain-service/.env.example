# ─── Blockchain (Sepolia) ──────────────────────────────────────────────────────
# Mismas variables que usas en tu .env.blockchain existente del proyecto.

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY
SEPOLIA_PRIVATE_KEY=tu_clave_privada_sin_o_con_0x
SEPOLIA_FROM_ADDRESS=0xTU_WALLET_ADDRESS
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_CONTRACT_ADDR=0xDIRECCION_DEL_CONTRATO_AUDITORIAEVENTOS
ETHERSCAN_API_KEY=tu_api_key_etherscan

# ─── Servicio ─────────────────────────────────────────────────────────────────
PORT=3001

# Clave compartida entre Laravel y este microservicio (header x-internal-key)
# Generar con: openssl rand -hex 32
INTERNAL_API_KEY=
